# Copy to .env.local and fill in. Never commit it.
# Robinhood Chain mainnet (4663). There is no testnet or second network to switch to.

# Build-time: these are inlined into the browser bundle by `next build`, so they must be present when
# the build runs, not only when the server starts.
NEXT_PUBLIC_CHAIN=mainnet
NEXT_PUBLIC_ESCROW_ADDRESS=0x906a6E30B3E35a6A7838d2D01995da0E62b7C6a6
NEXT_PUBLIC_NAMES_ADDRESS=0x6EF287a4AFa957B81D899203E46a5186A6D3B810
NEXT_PUBLIC_WIF_ADDRESS=0x5173b8eA6923c2d40267890D45C46a3480954773
NEXT_PUBLIC_WIF_USD=0.00157

# The block the registry was created in. The talent board scans events from here; a value above the
# chain head returns nothing at all and renders as an empty board rather than an error.
NEXT_PUBLIC_NAMES_DEPLOY_BLOCK=110690230

# Server-only. Never NEXT_PUBLIC_*: those are inlined into the browser bundle, and a billed RPC key
# read from one is a published credential.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Operators, in addition to the treasury and resolver (both read from the contract). Inlined at
# build time: the /admin page checks this in the browser before offering a sign-in.
# NEXT_PUBLIC_ADMIN_ADDRESSES=0x2bAFb4513b5e9a8C6BBb9ce063f5b18BF1B2cc1E

# Server-side secret used to sign admin and session cookies (HMAC). Rotating it logs every operator
# out. Required in production — there is no built-in default.
# SESSION_SECRET=

# Content store. Required in production: without it the app raises at boot rather than falling back
# to a JSON file on an ephemeral filesystem.
# DATABASE_URL=postgres://user:pass@host:5432/pact
# DATABASE_SSL_MODE=disable   # only for a network you trust