# Copy to .env and fill in. Nothing here is a wallet key: the server never holds one.
#
# The intent/nonce ledger. Required — the server refuses to boot without it.
DATABASE_URL=postgres://user:pass@host:5432/pact

# Signs session tokens. Must be the same value the web app uses, otherwise a token minted here is
# rejected there. Required in production; there is no development default.
# SESSION_SECRET=

# Robinhood Chain mainnet (4663). The server has one chain and no fallback.
PACT_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The deployed contracts. Required: an unset address is a boot failure, not a default.
PACT_ESCROW_ADDRESS=0x906a6E30B3E35a6A7838d2D01995da0E62b7C6a6
PACT_NAMES_ADDRESS=0x6EF287a4AFa957B81D899203E46a5186A6D3B810
PACT_WIF_ADDRESS=0x5173b8eA6923c2d40267890D45C46a3480954773

# The block the escrow was deployed in. Defaults to the real one; set it only if you redeploy.
# PACT_ESCROW_DEPLOY_BLOCK=110690230

# Defaults to 8787.
# PORT=8787