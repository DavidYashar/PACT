# Copy to .env and fill in. Never commit .env.
# Robinhood Chain mainnet (chain id 4663). There is no testnet: these addresses are live.
#
# The deployer signs the deployment and pays its gas. It should hold gas and nothing else.
PRIVATE_KEY=
MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Where the 5% settlement cut and the 10% filing fee land. `immutable` in the escrow, so a wrong
# value here is a redeploy of both contracts, which also loses the registry.
MAINNET_TREASURY=

# The only address allowed to rule on tickets. Bounded: it chooses between the two parties and there
# is no recipient parameter anywhere in the ruling path. Distinct from the treasury and the deployer,
# or the deploy script refuses to run.
MAINNET_RESOLVER=

# Optional, for redeploying against a local anvil node (scripts/DeployLocal.s.sol) instead:
# RPC_URL=http://127.0.0.1:8545